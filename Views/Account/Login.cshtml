@model Avatar_project.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="row justify-content-center align-items-center min-vh-100" style="margin-top: -5rem;">
    <div class="col-md-5">
        <div class="card shadow-lg border-0 rounded-4" style="background-color: #1a1d24;">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <h3 class="fw-bold" style="color: #00d4ff;"><i class="fa-solid fa-right-to-bracket me-2"></i>Sign in to Avatar Universe</h3>
                    <p class="text-muted mt-2">Log in to rate and track your favorite movies.</p>
                </div>
                
                @if (TempData["RegisterSuccess"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fa-solid fa-circle-check me-2"></i>@TempData["RegisterSuccess"]
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <div asp-validation-summary="ModelOnly" class="alert alert-danger fw-bold" role="alert"></div>

                <form method="post" asp-controller="Account" asp-action="Login">
                    
                    <div class="mb-3">
                        <label asp-for="Username" class="form-label fw-semibold text-light">Username</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-secondary"><i class="fa-solid fa-user"></i></span>
                            <input asp-for="Username" id="loginUsername" class="form-control border-secondary" placeholder="Enter your username" />
                        </div>
                        <span asp-validation-for="Username" class="text-danger small mt-1 d-block"></span>
                    </div>
                    
                    <div class="mb-4">
                        <label asp-for="Password" class="form-label fw-semibold text-light">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-secondary"><i class="fa-solid fa-lock"></i></span>
                            <input asp-for="Password" class="form-control border-secondary" placeholder="Enter your password" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                    </div>
                    
                    <div class="d-grid mb-4">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm" style="background-color: #5b21b6; border-color: #5b21b6;">
                            Sign In
                        </button>
                    </div>

                </form>

                <div class="text-center mt-2 border-top border-secondary pt-4">
                    <span class="text-muted">Don’t have an account?</span> 
                    <a asp-controller="Account" asp-action="Register" class="text-info fw-bold text-decoration-none ms-1">Create one here.</a>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Optional: Simple script to fill from LocalStorage if there is a recently registered user -->
<script>
    document.addEventListener("DOMContentLoaded", function() {
        let usersStr = localStorage.getItem("avatar_users");
        if (usersStr) {
            let users = JSON.parse(usersStr);
            if (users.length > 0) {
                // Pre-fill the last registered user's username for convenience
                let lastUser = users[users.length - 1];
                if (!document.getElementById('loginUsername').value) {
                    document.getElementById('loginUsername').value = lastUser.username;
                }
            }
        }
    });
</script>
