@model Avatar_project.Models.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="row justify-content-center align-items-center min-vh-100" style="margin-top: -5rem;">
    <div class="col-md-5">
        <div class="card shadow-lg border-0 rounded-4" style="background-color: #1a1d24;">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <h3 class="fw-bold" style="color: #00d4ff;"><i class="fa-solid fa-user-plus me-2"></i>Create your account</h3>
                    <p class="text-muted mt-2">Join Avatar Universe to save and rate movies.</p>
                </div>
                
                @if (ViewBag.RegistrationSuccess == true)
                {
                    <div class="alert alert-success fw-bold text-center" role="alert">
                        <i class="fa-solid fa-spinner fa-spin me-2"></i> Account created! Redirecting to login...
                    </div>

                    <!-- Client-side script to simulate DB save to LocalStorage for this school project -->
                    <script>
                        let users = JSON.parse(localStorage.getItem("avatar_users") || "[]");
                        users.push({
                            username: "@ViewBag.RegisteredUsername",
                            password: "@ViewBag.RegisteredPassword"
                        });
                        localStorage.setItem("avatar_users", JSON.stringify(users));
                        
                        setTimeout(() => {
                            window.location.href = '/Account/Login';
                        }, 2000);
                    </script>
                }
                else
                {
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger fw-bold" role="alert"></div>

                    <form method="post" asp-controller="Account" asp-action="Register">
                        
                        <div class="mb-3">
                            <label asp-for="Username" class="form-label fw-semibold text-light">Username</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-secondary"><i class="fa-solid fa-user"></i></span>
                                <input asp-for="Username" class="form-control border-secondary" placeholder="Choose a username" />
                            </div>
                            <span asp-validation-for="Username" class="text-danger small mt-1 d-block"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-semibold text-light">Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-secondary"><i class="fa-solid fa-lock"></i></span>
                                <input asp-for="Password" class="form-control border-secondary" placeholder="Choose a password" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold text-light">Confirm Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-secondary"><i class="fa-solid fa-lock"></i></span>
                                <input asp-for="ConfirmPassword" class="form-control border-secondary" placeholder="Confirm your password" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                        </div>
                        
                        <div class="d-grid mb-4">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm" style="background-color: #5b21b6; border-color: #5b21b6;">
                                Create Account
                            </button>
                        </div>
                    </form>
                }

                <div class="text-center mt-2 border-top border-secondary pt-4">
                    <span class="text-muted">Already have an account?</span> 
                    <a asp-controller="Account" asp-action="Login" class="text-info fw-bold text-decoration-none ms-1">Sign in here.</a>
                </div>

            </div>
        </div>
    </div>
</div>
