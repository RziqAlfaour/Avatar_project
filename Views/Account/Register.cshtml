@model Avatar_project.Models.User
@{
    ViewData["Title"] = "Create Account";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow border-0 rounded-3">
                <div class="card-header bg-success text-white text-center py-3 rounded-top">
                    <h4 class="mb-0">Create New Account</h4>
                </div>
                <div class="card-body p-4">
                    
                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            @ViewBag.ErrorMessage
                        </div>
                    }

                    @if (ViewBag.RegistrationSuccess == true)
                    {
                        <div class="alert alert-success" role="alert">
                            Account created successfully! Saving to LocalStorage and redirecting to Login...
                        </div>

                        <!-- JavaScript to save user locally and redirect -->
                        <script>
                            // 1. Get existing users from LocalStorage or create empty array
                            let users = JSON.parse(localStorage.getItem("avatar_users") || "[]");
                            
                            // 2. Add new user
                            users.push({
                                username: "@ViewBag.RegisteredUsername",
                                password: "@ViewBag.RegisteredPassword"
                            });
                            
                            // 3. Save back to LocalStorage
                            localStorage.setItem("avatar_users", JSON.stringify(users));
                            
                            // 4. Redirect to login page after a short delay
                            setTimeout(() => {
                                window.location.href = '/Account/Login';
                            }, 2000);
                        </script>
                    }
                    else
                    {
                        <form method="post" asp-controller="Account" asp-action="Register">
                            <div class="form-group mb-3">
                                <label asp-for="Username" class="form-label fw-bold">Username</label>
                                <input asp-for="Username" class="form-control" type="text" placeholder="Choose a username" required />
                            </div>
                            
                            <div class="form-group mb-4">
                                <label asp-for="Password" class="form-label fw-bold">Password</label>
                                <input asp-for="Password" class="form-control" type="password" placeholder="Choose a password" required />
                            </div>
                            
                            <div class="d-grid mb-3">
                                <button type="submit" class="btn btn-success btn-lg">Create Account</button>
                            </div>
                        </form>
                    }

                    <div class="text-center mt-3">
                        <span class="text-muted">Already have an account?</span> 
                        <a asp-controller="Account" asp-action="Login" class="text-success fw-bold text-decoration-none">Login here</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
