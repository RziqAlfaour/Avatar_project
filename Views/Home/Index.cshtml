@model HomeViewModel

@functions {
    string Average(List<int> arr)
    {
        if (arr == null || !arr.Any()) return "0.0";
        return arr.Average().ToString("0.0");
    }

    int Highest(List<int> arr)
    {
        if (arr == null || !arr.Any()) return 0;
        return arr.Max();
    }
}

@{
    var allMovieRatings = Model.MovieRatings.Select(x => x.Rating).ToList();
    var averageRating = allMovieRatings.Any() ? allMovieRatings.Average().ToString("0.0") : "0.0";
    var highestRating = allMovieRatings.Any() ? allMovieRatings.Max() : 0;
    var totalRatings = allMovieRatings.Count;
}

<a href="#mainContent" class="skip-link">Skip to content</a>

<div class="page-bg"></div>

<header class="hero-header">
    <section class="hero" id="home" style="margin-top: 1rem; border-radius: 1rem;">
        <div class="hero-text glass-card">
            <p class="eyebrow text-info fw-bold mb-2"><i class="fa-solid fa-film me-2"></i>Avatar Universe</p>
            @if (ViewBag.Username != null)
            {
                <h1 style="font-size: 2.8rem; color: #f1f1f1; font-weight: 700;">Discover Your Next Favorite Movie</h1>
                <p class="text-muted mt-3" style="font-size: 1.1rem;">
                    Welcome back, <strong>@ViewBag.Username</strong>! Browse movies, track what you’ve watched, and rate your favorites.
                </p>
                <div class="hero-buttons mt-4">
                    <a href="#movies" class="btn btn-primary rounded-pill px-4 me-2 border-0 shadow-sm" style="background-color: #5b21b6;">Explore Movies</a>
                    <a href="#characters" class="btn btn-outline-info rounded-pill px-4 border-2">View Characters</a>
                </div>
            }
            else
            {
                <h1 style="font-size: 3rem; font-weight: 700;">Discover Your Next Favorite Movie</h1>
                <p class="text-muted mt-3" style="font-size: 1.1rem;">
                    Browse movies, track what you’ve watched, and rate your favorites. Sign in to get a personalized experience.
                </p>
                <div class="hero-buttons mt-4">
                    <a asp-controller="Account" asp-action="Register" class="btn btn-primary rounded-pill px-4 me-2 border-0 shadow-sm" style="background-color: #5b21b6;">Get Started</a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-info rounded-pill px-4 border-2">Sign In</a>
                </div>
            }
        </div>

        <div class="hero-stats glass-card">
            <div class="stat-box">
                <span id="charactersCount">@Model.Characters.Count</span>
                <p>Characters</p>
            </div>
            <div class="stat-box">
                <span id="commentsCount">@Model.Comments.Count</span>
                <p>Comments</p>
            </div>
            <div class="stat-box">
                <span id="topRatedValue">@highestRating</span>
                <p>Top Rating</p>
            </div>
        </div>
    </section>
</header>

<main id="mainContent" class="main-layout mt-5">

    <!-- NEW: Static Movies Section -->
    <section id="movies" class="section-block mb-5">
        <div class="section-head mb-4">
            <div>
                <p class="section-tag text-info fw-bold mb-1"><i class="fa-solid fa-fire me-2"></i>Trending</p>
                <h2 class="fw-bold">Featured Titles</h2>
            </div>
        </div>
        
        <div class="row row-cols-1 row-cols-md-3 g-4">
            <!-- Movie 1 -->
            <div class="col">
                <div class="card h-100 shadow-sm border-0 rounded-4" style="background-color: #1a1d24;">
                    <div style="height: 200px; background: linear-gradient(45deg, #0f1115, #2a2d35); border-radius: 1rem 1rem 0 0;" class="d-flex justify-content-center align-items-center">
                        <i class="fa-solid fa-film fa-3x text-secondary"></i>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title fw-bold mb-0">Avatar</h5>
                            <span class="badge bg-dark text-warning"><i class="fa-solid fa-star me-1"></i> 8.4</span>
                        </div>
                        <p class="text-muted small mb-2">2009 &bull; Sci-Fi/Action</p>
                        <p class="card-text text-light" style="font-size: 0.9rem;">A paraplegic Marine dispatched to the moon Pandora on a unique mission becomes torn between following his orders and protecting the world he feels is his home.</p>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-3 text-center">
                        @if (ViewBag.Username != null)
                        {
                            <button class="btn btn-sm btn-outline-info rounded-pill px-3 w-100"><i class="fa-solid fa-plus me-1"></i> Add to Watchlist</button>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-secondary rounded-pill px-3 w-100">Sign in to Rate</a>
                        }
                    </div>
                </div>
            </div>
            
            <!-- Movie 2 -->
            <div class="col">
                <div class="card h-100 shadow-sm border-0 rounded-4" style="background-color: #1a1d24;">
                    <div style="height: 200px; background: linear-gradient(45deg, #1f1c2c, #928DAB); border-radius: 1rem 1rem 0 0;" class="d-flex justify-content-center align-items-center">
                        <i class="fa-solid fa-image fa-3x text-light opacity-50"></i>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title fw-bold mb-0">Avatar: The Way of Water</h5>
                            <span class="badge bg-dark text-warning"><i class="fa-solid fa-star me-1"></i> 8.6</span>
                        </div>
                        <p class="text-muted small mb-2">2022 &bull; Sci-Fi/Action</p>
                        <p class="card-text text-light" style="font-size: 0.9rem;">Jake Sully lives with his newfound family formed on the extrasolar moon Pandora. Once a familiar threat returns, Jake must work with Neytiri and the army of the Na'vi race to protect their home.</p>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-3 text-center">
                        @if (ViewBag.Username != null)
                        {
                            <button class="btn btn-sm btn-outline-info rounded-pill px-3 w-100"><i class="fa-solid fa-plus me-1"></i> Add to Watchlist</button>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-secondary rounded-pill px-3 w-100">Sign in to Rate</a>
                        }
                    </div>
                </div>
            </div>
            
            <!-- Movie 3 -->
            <div class="col">
                <div class="card h-100 shadow-sm border-0 rounded-4" style="background-color: #1a1d24;">
                    <div style="height: 200px; background: linear-gradient(45deg, #2c3e50, #3498db); border-radius: 1rem 1rem 0 0;" class="d-flex justify-content-center align-items-center">
                        <i class="fa-solid fa-video fa-3x text-light opacity-50"></i>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title fw-bold mb-0">Avatar: Fire and Ash</h5>
                            <span class="badge bg-dark text-muted"><i class="fa-solid fa-clock me-1"></i> TBD</span>
                        </div>
                        <p class="text-muted small mb-2">2025 &bull; Sci-Fi/Adventure</p>
                        <p class="card-text text-light" style="font-size: 0.9rem;">The upcoming third installment in the Avatar film series. Get ready for new adventures exploring the volatile ash tribes of Pandora.</p>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-3 text-center">
                        @if (ViewBag.Username != null)
                        {
                            <button class="btn btn-sm btn-outline-info rounded-pill px-3 w-100"><i class="fa-regular fa-bell me-1"></i> Remind Me</button>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-secondary rounded-pill px-3 w-100">Sign in for Updates</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="characters" class="section-block border-top border-secondary pt-5">
        <div class="section-head">
            <div>
                <p class="section-tag">Search + Rating + Favorites</p>
                <h2>Characters</h2>
            </div>

            <div class="controls">
                <input type="text" id="searchInput" placeholder="Search character... e.g. Jake" />
                <select id="roleFilter">
                    <option value="all">All Roles</option>
                    <option value="hero">Hero</option>
                    <option value="leader">Leader</option>
                    <option value="scientist">Scientist</option>
                    <option value="villain">Villain</option>
                    <option value="pilot">Pilot</option>
                </select>
            </div>
        </div>

        <div id="charactersContainer" class="characters-grid">
            @foreach (var chara in Model.Characters)
            {
                var isFavorite = Model.Favorites.Contains(chara.Id);

                    <article class="character-card character-item"
                             data-name="@chara.Name.ToLower()"
                             data-role="@chara.Role">
                        <div class="character-image-wrap">
                            <img src="~/images/@chara.Image" alt="@chara.Name" class="character-image" />
                        </div>

                        <div class="character-body">
                            <div class="character-top">
                                <div>
                                    <h3 class="character-name">@chara.Name</h3>
                                    <span class="role-badge">@chara.Role</span>
                                </div>
                            </div>

                            <p>@chara.Description</p>

                            <div class="rating-stars">
                            @for (int i = 1; i <= 5; i++)
                            {
                                        <form asp-action="RateCharacter" method="post">
                                            <input type="hidden" name="characterId" value="@chara.Id" />
                                            <input type="hidden" name="value" value="@i" />
                                            <button class="star-btn" type="submit" title="Rate @i">⭐</button>
                                        </form>
                            }
                            </div>

                            <div class="card-meta">
                                <span>Average: @Average(chara.Ratings)</span>
                                <span>Highest: @Highest(chara.Ratings)</span>
                            </div>

                            <div class="card-actions">
                                <form asp-action="ToggleFavorite" method="post">
                                    <input type="hidden" name="characterId" value="@chara.Id" />
                                    <button class="action-btn favorite @(isFavorite ? "active" : "")" type="submit">
                                    @(isFavorite ? "❤️ Remove Favorite" : "🤍 Add Favorite")
                                    </button>
                                </form>
                            </div>
                        </div>
                    </article>
            }
        </div>

        <div class="pagination" id="pagination"></div>
    </section>

    <section id="reviews" class="section-block two-columns">
        <div class="glass-card panel">
            <div class="section-head small">
                <div>
                    <p class="section-tag">Movie Rating</p>
                    <h2>Rate The Film</h2>
                </div>
            </div>

            <form asp-action="AddMovieRating" method="post" id="ratingForm" class="stack-form">
                <label for="movieRaterName">Your Name</label>
                <input type="text" id="movieRaterName" name="user" placeholder="Enter your name" required />

                <label for="movieRating">Choose Rating</label>
                <select id="movieRating" name="rating" required>
                    <option value="">Select from 1 to 5</option>
                    <option value="1">1 Star</option>
                    <option value="2">2 Stars</option>
                    <option value="3">3 Stars</option>
                    <option value="4">4 Stars</option>
                    <option value="5">5 Stars</option>
                </select>

                <button type="submit" class="primary-btn">Submit Rating</button>
            </form>

            <div class="rating-summary">
                <div class="summary-card">
                    <h3>Average Rating</h3>
                    <p id="averageRating">@averageRating</p>
                </div>
                <div class="summary-card">
                    <h3>Highest Rating</h3>
                    <p id="highestRating">@highestRating</p>
                </div>
                <div class="summary-card">
                    <h3>Total Votes</h3>
                    <p id="totalRatings">@totalRatings</p>
                </div>
            </div>
        </div>

        <div class="glass-card panel">
            <div class="section-head small">
                <div>
                    <p class="section-tag">Comments</p>
                    <h2>User Reviews</h2>
                </div>
            </div>

            <form asp-action="AddComment" method="post" id="commentForm" class="stack-form">
                <label for="commentUser">Your Name</label>
                <input type="text" id="commentUser" name="user" placeholder="Enter your name" required />

                <label for="commentText">Your Comment</label>
                <textarea id="commentText" name="text" rows="4" placeholder="Write your comment..." required></textarea>

                <button type="submit" class="primary-btn">Add Comment</button>
            </form>

            <div id="commentsList" class="comments-list">
                @if (Model.Comments.Any())
                {
                    @foreach (var comment in Model.Comments.OrderByDescending(x => x.Id))
                    {
                                <div class="comment-item">
                                    <h4>@comment.User</h4>
                                    <p>@comment.Text</p>
                                    <form asp-action="DeleteComment" method="post">
                                        <input type="hidden" name="id" value="@comment.Id" />
                                        <button type="submit">Delete My Comment</button>
                                    </form>
                                </div>
                    }
                }
                else
                {
                        <div class="empty-box">No comments yet.</div>
                }
            </div>
        </div>
    </section>

    <section id="favorites" class="section-block">
        <div class="section-head">
            <div>
                <p class="section-tag">Favorites System</p>
                <h2>Favorite Characters</h2>
            </div>
        </div>

        <div id="favoritesContainer" class="favorites-grid">
            @{
                var favoriteCharacters = Model.Characters.Where(c => Model.Favorites.Contains(c.Id)).ToList();
            }

            @if (favoriteCharacters.Any())
            {
                @foreach (var chara in favoriteCharacters)
                {
                            <article class="character-card">
                                <div class="character-image-wrap">
                                    <img src="~/images/@chara.Image" alt="@chara.Name" class="character-image" />
                                </div>

                                <div class="character-body">
                                    <h3 class="character-name">@chara.Name</h3>
                                    <p>@chara.Description</p>

                                    <form asp-action="ToggleFavorite" method="post">
                                        <input type="hidden" name="characterId" value="@chara.Id" />
                                        <button class="action-btn favorite active" type="submit">
                                            ❤️ Remove Favorite
                                        </button>
                                    </form>
                                </div>
                            </article>
                }
            }
            else
            {
                    <div class="empty-box">No favorite characters yet.</div>
            }
        </div>
    </section>

    <section id="admin" class="section-block">
        <div class="section-head">
            <div>
                <p class="section-tag">Admin Dashboard</p>
                <h2>Manage Characters</h2>
            </div>
            <div style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
                <span id="adminStatus" class="status-badge">
                    @(Model.IsAdmin ? "Admin Mode" : "User Mode")
                </span>
                <form asp-action="ToggleAdmin" method="post" class="d-flex align-items-center gap-2">
                    <input type="password" name="password" placeholder="admin password" class="form-control form-control-sm bg-dark text-light border-secondary" style="width: 150px;" />
                    <button type="submit" id="loginToggle" class="btn btn-sm btn-warning fw-bold">
                        @(Model.IsAdmin ? "Exit Admin" : "Login Admin")
                    </button>
                </form>
            </div>
        </div>

        <div class="admin-layout">
            <div class="glass-card panel">
                <h3 class="panel-title">Character Form</h3>

                <form asp-action="SaveCharacter" method="post" id="characterForm" class="stack-form">
                    <input type="hidden" id="characterId" name="Id" />

                    <label for="characterName">Character Name</label>
                    <input type="text" id="characterName" name="Name" placeholder="Character name" required />

                    <label for="characterRole">Role</label>
                    <select id="characterRole" name="Role" required>
                        <option value="">Select role</option>
                        <option value="hero">Hero</option>
                        <option value="leader">Leader</option>
                        <option value="scientist">Scientist</option>
                        <option value="villain">Villain</option>
                        <option value="pilot">Pilot</option>
                    </select>

                    <label for="characterDescription">Description</label>
                    <textarea id="characterDescription" name="Description" rows="4" placeholder="Short description" required></textarea>

                    <label for="characterImage">Image Name</label>
                    <input type="text" id="characterImage" name="Image" placeholder="jake.jpg" required />

                    <div class="form-actions">
                        <button type="submit" class="primary-btn">Save Character</button>
                        <button type="button" id="resetFormBtn" class="secondary-btn">Reset</button>
                    </div>
                </form>
            </div>

            <div class="glass-card panel">
                <h3 class="panel-title">Dashboard</h3>

                <div class="dashboard-stats">
                    <div class="summary-card">
                        <h4>Total Characters</h4>
                        <p id="dashCharacters">@Model.Characters.Count</p>
                    </div>
                    <div class="summary-card">
                        <h4>Total Comments</h4>
                        <p id="dashComments">@Model.Comments.Count</p>
                    </div>
                    <div class="summary-card">
                        <h4>Top Rated</h4>
                        <p id="dashTopRated">@highestRating</p>
                    </div>
                </div>

                <div class="admin-table-wrap">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Role</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="adminCharactersTable">
                            @foreach (var chara in Model.Characters)
                            {
                                    <tr>
                                        <td>@chara.Name</td>
                                        <td>@chara.Role</td>
                                        <td>
                                            <div class="table-actions">
                                                <button class="edit-btn edit-character-btn"
                                                        type="button"
                                                        data-id="@chara.Id"
                                                        data-name="@chara.Name"
                                                        data-role="@chara.Role"
                                                        data-description="@chara.Description"
                                                        data-image="@chara.Image"
                                            @(!Model.IsAdmin ? "disabled" : null)>
                                                    Edit
                                                </button>

                                                <form asp-action="DeleteCharacter" method="post">
                                                    <input type="hidden" name="id" value="@chara.Id" />
                                                    <button class="delete-btn" type="submit" @(!Model.IsAdmin ? "disabled" : null)>
                                                        Delete
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
</main>