<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Avatar Universe</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    
    <link rel="stylesheet" href="~/css/lara.css" />

    <style>
        body {
            background-color: #0f1115;
            color: #f1f1f1;
            font-family: 'Poppins', sans-serif;
        }
        .navbar {
            background-color: rgba(15, 17, 21, 0.95) !important;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }
        .navbar-brand {
            font-family: 'Orbitron', sans-serif;
            font-weight: 700;
            color: #00d4ff !important;
            letter-spacing: 1px;
        }
        .nav-link {
            color: #f1f1f1 !important;
            font-weight: 500;
            transition: color 0.3s ease;
        }
        .nav-link:hover {
            color: #00d4ff !important;
        }
        .card {
            background-color: #1a1d24;
            color: #fff;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }
        .form-control {
            background-color: #2a2d35;
            border-color: #444;
            color: #fff;
        }
        .form-control:focus {
            background-color: #2a2d35;
            color: #fff;
            border-color: #00d4ff;
            box-shadow: 0 0 0 0.25rem rgba(0, 212, 255, 0.25);
        }
        .btn-primary {
            background-color: #5b21b6;
            border-color: #5b21b6;
        }
        .btn-primary:hover {
            background-color: #4c1d95;
            border-color: #4c1d95;
        }
        .btn-outline-info {
            color: #00d4ff;
            border-color: #00d4ff;
        }
        .btn-outline-info:hover {
            background-color: #00d4ff;
            color: #000;
        }
    </style>
</head>
<body>
    @using Microsoft.AspNetCore.Http

    <!-- Global Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark sticky-top shadow-sm py-3">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-clapperboard me-2"></i> Avatar Universe
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">Movies</a>
                    </li>
                </ul>
                <div class="d-flex align-items-center">
                    @{
                        var username = Context.Session.GetString("Username");
                    }
                    
                    @if (!string.IsNullOrEmpty(username))
                    {
                        <span class="me-3 text-light"><i class="fa-solid fa-user-circle text-info me-1"></i> Welcome, <strong>@username</strong></span>
                        <a asp-controller="Account" asp-action="Logout" class="btn btn-sm btn-outline-danger px-3 rounded-pill"><i class="fa-solid fa-right-from-bracket me-1"></i> Logout</a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-info me-2 px-3 rounded-pill">Login</a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-sm btn-primary px-3 rounded-pill">Register</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container py-4">
        @RenderBody()
    </div>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/lara.js"></script>
</body>
</html>